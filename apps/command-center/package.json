{
  "name": "@mediobot-v2/command-center",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --experimental-strip-types src/server.ts",
    "build": "vite build",
    "test": "node --experimental-strip-types --test --test-timeout=30000 --test-concurrency=1 tests/runtime/*.test.ts tests/persistence/*.test.ts tests/workspace/open-folder.test.ts tests/workspace/workspace-foundation.test.ts tests/workspace/maestro-project-awareness.test.ts",
    "test:watchers": "node --experimental-strip-types tests/watchers/workspace-watcher.probe.ts",
    "test:ui": "node --experimental-strip-types --test --test-concurrency=1 tests/ui/*.test.ts",
    "test:e2e": "node --experimental-strip-types --test tests/e2e/*.test.ts",
    "test:live-models": "node --experimental-strip-types --test tests/live/live-models.test.ts",
    "collaboration:manual": "node --experimental-strip-types scripts/manual-collaboration.ts",
    "specialist-conversation:manual": "node --experimental-strip-types scripts/manual-specialist-conversation.ts",
    "research:manual": "node --experimental-strip-types scripts/research-pipeline.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@hugeicons/core-free-icons": "^4.3.5",
    "@hugeicons/react": "^1.1.10",
    "@lezer/highlight": "^1.2.5",
    "@mediobot-v2/cody": "workspace:*",
    "@mediobot-v2/domain": "workspace:*",
    "@mediobot-v2/maestro": "workspace:*",
    "@mediobot-v2/models": "workspace:*",
    "@mediobot-v2/runtime": "workspace:*",
    "@mediobot-v2/tester": "workspace:*",
    "@mediobot-v2/tools": "workspace:*",
    "@mediobot-v2/vision": "workspace:*",
    "@napi-rs/keyring": "^2.1.2",
    "codemirror": "^6.0.2",
    "highlight.js": "11.12.0",
    "jszip": "^3.10.1",
    "lucide-react": "0.546.0",
    "motion": "^14.1.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.1",
    "playwright": "1.63.0",
    "tailwindcss": "4.3.3",
    "vite": "8.3.0"
  }
}
