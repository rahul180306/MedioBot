    "test:headed": "node --experimental-strip-types --test --test-concurrency=1 tests/controlled-lifecycle.test.ts tests/focused-no-effect.test.ts",
    "manual": "node --experimental-strip-types tests/manual/vision-manual.ts",
    "benchmark": "node --experimental-strip-types tests/manual/benchmark-preview.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@mediobot-v2/domain": "workspace:*",
    "@mediobot-v2/models": "workspace:*",
    "@mediobot-v2/runtime": "workspace:*",
    "playwright": "1.63.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.3"
  }
